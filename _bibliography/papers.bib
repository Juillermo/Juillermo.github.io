	html = {https://arxiv.org/abs/2610.13839},
	pdf = {https://arxiv.org/pdf/2610.13839},
	abstract = {Disinformation on online social media has been on the rise in the past years. While there is extensive literature modelling social cascades, online disinformation cascades show distinctive characteristics: they provoke debunking reactions, they spread over networks with heterogeneous connectivity, and they compete for the limited attention of users --- which recommendation algorithms may partly offset. We propose a model including these ingredients and study it through Monte--Carlo simulations and mean--field approximations, on random graphs and an empirical Twitter network. We find that debunking reactions are double--edged: they reduce the reach of appealing items but allow unappealing ones to reach audiences they would not otherwise reach. Degree heterogeneity makes cascades trigger at a much lower content appeal but limits their final reach: heterogeneous networks are easy to ignite yet hard to saturate. Limited attention cancels the effects from degree heterogeneity, although the mediation of recommendation algorithms may restore them.},
	author = {Romero Moreno, Guillermo and Robu, Valentin and La Poutr{\'e}, Han},
	month = oct,
	year = {2026},
	bibtex_show={true},
}

@article{burattini_freire_simpol_2026,
	doi = {10.48550/arXiv.2606.27968},
	title = {{SimPol}: Simulating polarisation in political belief networks in {European} countries},
	copyright = {All rights reserved},
	journal = {arXiv preprint arXiv:2606.27968},
	note = {Preprint. Complexity72h 2026 project},
	status = {preprint},
	preview = {simpol.png},
	url = {https://arxiv.org/abs/2606.27968},
	arxiv = {2606.27968},
	html = {https://arxiv.org/abs/2606.27968},
	pdf = {https://arxiv.org/pdf/2606.27968},
	abstract = {Here we combine empirical network analysis with agent-based modelling to understand how different ways of structuring belief systems may affect the polarisation drive, and how the diversity of belief systems in Europe may result in different polarisation trajectories. Using the 2016 European Social Survey, we infer belief networks across 23 European countries via a Bayesian algorithm, revealing that belief systems are predominantly organised around immigration, LGBT rights, and economic interventionism, reflecting the influence of populist discourse across the continent. We further verify a Western-Eastern divide across the national belief networks: in Western European countries, left-right self-identification is a more reliable predictor of broader belief alignment, whereas in Eastern Europe this relationship breaks down. By applying these empirical belief networks into a sociologically grounded agent-based model, we further show that polarisation is amplified by high individual belief rigidity and low susceptibility to social influence, and that cross-country differences in polarisation levels mirror the same geographic divide observed in belief network topology. These findings establish belief networks topologies as a structural driver of political polarisation, with implications for understanding and anticipating polarisation dynamics across diverse European contexts. We find that populations are not polarised when little attention is placed on maintaining internal coherence and polarisation levels are moderate when high attention is placed in both keeping internal coherence and agreement in beliefs with others.},
	author = {Burattini Freire, Isabela and Cha, Hongryol and Epure, Irina and Filippini, Sara and Manjunatha, Karan K. H. and Kavaraganahalli Prasanna, Chethan and Samoylenko, Ivan and Van Santen, Niels and Prabhakaran, Adarsh and Romero Moreno, Guillermo},
	month = jun,
	year = {2026},
}

